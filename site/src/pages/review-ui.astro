---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BuiltInCommentViewer from '../components/BuiltInCommentViewer.astro';
import ReviewGuideExample from '../components/ReviewGuideExample.astro';
import { codeThemes } from '../lib/code-theme';

const transcriptExample = `import { DocxDocument } from '@silurus/ooxml/docx';

const doc = await DocxDocument.load(source);

showTranscript({
  comments: doc.comments,
  revisions: doc.revisions,
});

// Keep the document only while you still need to render pages.
doc.destroy();`;

const scrollViewerExample = `import { DocxScrollViewer } from '@silurus/ooxml/docx';

const viewer = new DocxScrollViewer(container, {
  showComments: true,
});

await viewer.load(source);`;

const themeExample = `#viewer {
  --ooxml-comment-card-background: #ffffff;
  --ooxml-comment-card-active-background: #dbeafe;
  --ooxml-comment-card-radius: 10px;
  --ooxml-comment-avatar-radius: 999px;
  --ooxml-comment-highlight: rgba(59, 130, 246, 0.18);
  --ooxml-comment-highlight-active: rgba(37, 99, 235, 0.34);
  --ooxml-comment-connector: #94a3b8;
  --ooxml-comment-connector-active: #2563eb;
  --ooxml-comment-connector-dasharray: 4 4;
  --ooxml-comment-connector-linecap: round;
}`;

const themeReference = `#viewer {
  /* DOCX, XLSX, and PPTX */
  --ooxml-comment-font-family: system-ui, sans-serif;
  --ooxml-comment-author-color: #0f172a;
  --ooxml-comment-body-color: #334155;
  --ooxml-comment-card-background: #fff;
  --ooxml-comment-card-border: 1px solid rgba(148, 163, 184, .24);
  --ooxml-comment-card-radius: .62em;
  --ooxml-comment-card-shadow: 0 .08em .16em rgba(15, 23, 42, .12);
  --ooxml-comment-card-padding: .78em .92em;
  --ooxml-comment-reply-border: rgba(100, 116, 139, .2);

  /* DOCX and PPTX margins */
  --ooxml-comment-content-gap: .65em;
  --ooxml-comment-avatar-background: #2563eb;
  --ooxml-comment-avatar-color: #fff;
  --ooxml-comment-avatar-radius: .7em;
  --ooxml-comment-date-font-family: ui-monospace, monospace;
  --ooxml-comment-muted-color: #64748b;
  --ooxml-comment-card-gap: .62em;
  --ooxml-comment-card-active-background: #dbeafe;
  --ooxml-comment-card-active-border: 1px solid rgba(37, 99, 235, .45);
  --ooxml-comment-card-active-shadow: 0 0 0 .12em rgba(37, 99, 235, .28);
  --ooxml-comment-card-focus-shadow: inset 0 0 0 .14em rgba(37, 99, 235, .7);
  --ooxml-comment-connector: #94a3b8;
  --ooxml-comment-connector-active: #2563eb;
  --ooxml-comment-connector-width: 1px;
  --ooxml-comment-connector-active-width: 1.5px;
  --ooxml-comment-connector-opacity: .45;
  --ooxml-comment-connector-active-opacity: .9;
  --ooxml-comment-connector-dasharray: none;
  --ooxml-comment-connector-linecap: butt;

  /* DOCX */
  --ooxml-comment-highlight: rgba(59, 130, 246, .18);
  --ooxml-comment-highlight-active: rgba(37, 99, 235, .34);

  /* PPTX */
  --ooxml-comment-marker-background: #2563eb;
  --ooxml-comment-marker-color: #fff;
  --ooxml-comment-marker-border: #fff;
  --ooxml-comment-marker-shadow: 0 1px 3px rgba(15, 23, 42, .28);
  --ooxml-comment-marker-active-shadow: 0 0 0 3px rgba(37, 99, 235, .35);
}`;

const anchoredExample = `import {
  DocxDocument,
  resolveCommentAnchorRuns,
  type DocxTextRunInfo,
} from '@silurus/ooxml/docx';

const doc = await DocxDocument.load(source);
const runs: DocxTextRunInfo[] = [];

await doc.renderPage(canvas, pageIndex, {
  width: 760,
  onTextRun: (run) => runs.push(run),
});

const commentsById = new Map(doc.comments.map((comment) => [comment.id, comment]));
const anchoredComments = doc.commentAnchorRanges().flatMap((anchor) => {
  const comment = commentsById.get(anchor.commentId);
  const geometry = resolveCommentAnchorRuns(anchor, runs);
  return comment && geometry.length ? [{ comment, geometry }] : [];
});

showReviewMargin({ canvas, anchoredComments });
// Destroy doc when the owning UI unmounts.`;
---

<Base
  title="DOCX comments and tracked changes | @silurus/ooxml"
  description="Use DOCX comments, tracked changes, anchors, and rendered geometry in an application-owned review UI."
  canonicalPath="/review-ui/"
>
  <Nav active="docx" />

  <header class="review-hero">
    <div class="wrap">
      <a class="back" href="/docx">← DOCX examples</a>
      <h1>DOCX comments and tracked changes</h1>
      <p class="lead">
        <code>@silurus/ooxml</code> reads review data already stored in a DOCX file and can relate it
        to rendered page text. <code>DocxScrollViewer</code> includes an optional read-only comment
        margin; the lower-level APIs remain available when an application needs a different layout.
      </p>
      <nav class="hero-actions" aria-label="Review UI resources">
        <a class="primary" href="#live-example">See the live example</a>
        <a href="/review-ui/source">Open complete example source</a>
        <a href="/api/docx#docx-document">DOCX API reference</a>
      </nav>
    </div>
  </header>

  <main class="wrap review-main">
    <section class="review-section" aria-labelledby="built-in-margin">
      <div class="section-heading">
        <h2 id="built-in-margin">Start with the built-in margin</h2>
        <p>Enable the default cards with one option. There is no comment UI or geometry work to manage.</p>
      </div>
      <div class="implementation-grid">
        <article>
          <h3>Default cards</h3>
          <p class="code-intro">Use the neutral read-only cards as they are.</p>
          <Code code={scrollViewerExample} lang="ts" themes={codeThemes} defaultColor={false} />
        </article>
        <article>
          <h3>Theme the default</h3>
          <p class="code-intro">Set CSS custom properties on the Viewer container. The structure and lifecycle stay Viewer-owned.</p>
          <Code code={themeExample} lang="css" themes={codeThemes} defaultColor={false} />
        </article>
      </div>
      <details class="theme-reference">
        <summary>
          <span class="theme-reference-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 9l-3 3l3 3m8-6l3 3l-3 3m-2-9l-4 12" /></svg>
          </span>
          <span class="theme-reference-copy">
            <strong>All comment theme properties</strong>
            <span>Browse every token and its default value.</span>
          </span>
          <svg class="theme-reference-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9l6 6l6-6" /></svg>
        </summary>
        <div class="theme-reference-body">
          <p>Copy only the properties your product theme needs.</p>
          <Code code={themeReference} lang="css" themes={codeThemes} defaultColor={false} />
        </div>
      </details>
      <div class="built-in-preview">
        <h3>Default appearance</h3>
        <p>The document keeps its page surface; the right margin contains only neutral cards, without a background band.</p>
        <BuiltInCommentViewer />
      </div>
    </section>

    <section class="review-section" aria-labelledby="concepts">
      <div class="section-heading">
        <h2 id="concepts">Review UI concepts</h2>
        <p>A review UI combines four concepts. Only the last two are needed when marks must follow text on a rendered page.</p>
      </div>
      <div class="concept-grid">
        <article><h3>Comments and threads</h3><p>Reviewer notes, replies, authors, dates, and resolved state.</p></article>
        <article><h3>Tracked changes</h3><p>Insertions, deletions, and moves recorded in the document.</p></article>
        <article><h3>Anchors</h3><p>Logical positions or ranges that connect a review record to document content.</p></article>
        <article><h3>Rendered geometry</h3><p>Text rectangles from one rendered page, used to place highlights or markers.</p></article>
      </div>
      <div class="table-wrap" role="region" aria-label="Review concepts and APIs" tabindex="0">
        <table>
          <thead><tr><th>Concept</th><th>Public API</th><th>Use</th></tr></thead>
          <tbody>
            <tr><th>Comments and threads</th><td><code>doc.comments</code></td><td>Build a thread list, transcript, search, or export.</td></tr>
            <tr><th>Tracked changes</th><td><code>doc.revisions</code></td><td>Label and filter recorded changes.</td></tr>
            <tr><th>Logical anchors</th><td><code>commentAnchorRanges()</code><br /><code>revisionAnchorRanges()</code></td><td>Connect records to document content.</td></tr>
            <tr><th>Visible page location</th><td><code>onTextRun</code><br /><code>resolveCommentAnchorRuns()</code><br /><code>resolveRevisionAnchorRuns()</code></td><td>Place markers or coordinate a margin with the current page.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="review-section" aria-labelledby="choose-ui">
      <div class="section-heading">
        <h2 id="choose-ui">Integration options</h2>
        <p>Use these lower-level paths only when the built-in margin does not fit the product UI.</p>
      </div>
      <div class="choice-grid">
        <article>
          <p class="choice-label">No page geometry</p>
          <h3>List, search, or export</h3>
          <p>Read <code>doc.comments</code> and <code>doc.revisions</code>, then render application-owned rows or serialized data.</p>
        </article>
        <article>
          <p class="choice-label">Page geometry required</p>
          <h3>Margin or separate pane</h3>
          <p>Resolve anchors for the current page so selecting a row can identify the related rendered text.</p>
        </article>
        <article>
          <p class="choice-label">Page geometry required</p>
          <h3>Highlights or markers</h3>
          <p>Draw application-owned SVG or DOM marks over the page using resolved text-run rectangles.</p>
        </article>
      </div>
    </section>

    <section class="review-section" aria-labelledby="minimum-flow">
      <div class="section-heading">
        <h2 id="minimum-flow">Minimum implementation</h2>
        <p>Start with the transcript path. Use the anchored path only if the UI needs a visible connection to page content.</p>
      </div>
      <div class="implementation-grid">
        <article>
          <h3>Transcript path</h3>
          <ol><li>Load the document.</li><li>Read comments and revisions.</li><li>Render your list, search results, or export.</li></ol>
          <Code code={transcriptExample} lang="ts" themes={codeThemes} defaultColor={false} />
        </article>
        <article>
          <h3>Anchored page path</h3>
          <ol><li>Render the current page and collect text runs.</li><li>Read logical anchors.</li><li>Resolve anchors against those runs.</li><li>Render your margin or markers.</li></ol>
          <Code code={anchoredExample} lang="ts" themes={codeThemes} defaultColor={false} />
        </article>
      </div>
    </section>

    <section class="review-section final-state" aria-labelledby="final-state">
      <div class="section-heading">
        <h2 id="final-state">Accepted-final rendering</h2>
        <p>DOCX pages use the accepted-final document. Recorded changes do not all have visible text in that result.</p>
      </div>
      <div class="final-state-grid">
        <article><h3>Visible in the page</h3><p>Insertions and move destinations can be highlighted using their resolved text geometry.</p></article>
        <article><h3>Absent from the page</h3><p>Deletions and move sources have no old text rectangle. Show their text in the transcript; a nearby final-state position may be used only as a marker.</p></article>
      </div>
    </section>

    <section id="live-example" class="review-section live-example" aria-labelledby="live-example-title">
      <div class="section-heading">
        <h2 id="live-example-title">Live example</h2>
        <p>The page, highlights, and right-hand review cards are application UI built from the APIs above.</p>
      </div>
      <ReviewGuideExample />
    </section>

    <section class="review-section next-steps" aria-labelledby="next-steps">
      <div class="section-heading">
        <h2 id="next-steps">Reference and production details</h2>
        <p>Canvas content needs an accessible transcript or text layer. Destroy an owned <code>DocxDocument</code> when its UI is finished.</p>
      </div>
      <nav class="detail-links" aria-label="Review UI details">
        <a href="/review-ui/source"><strong>Complete example source →</strong><span>See the controller, HTML, and CSS used by the live example.</span></a>
        <a href="/api/docx#docx-document"><strong>DOCX API reference →</strong><span>Look up review records, anchor ranges, text runs, and method signatures.</span></a>
        <a href="/production#rendering-mode"><strong>Rendering modes →</strong><span>Choose main-thread or Worker rendering for your application.</span></a>
      </nav>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .review-hero { padding: 50px 0 44px; border-bottom: 1px solid var(--border); }
  .back { color: var(--text-faint); font: 12px var(--mono); }
  .review-hero h1 { max-width: 920px; margin: 20px 0 16px; font-size: clamp(38px, 6vw, 66px); line-height: 1; letter-spacing: -.045em; }
  .lead { max-width: 78ch; color: var(--text-dim); font-size: 18px; line-height: 1.7; }
  code { font-family: var(--mono); font-size: .9em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; margin-top: 24px; }
  .hero-actions a { color: var(--accent); font-weight: 700; }
  .hero-actions .primary { padding: 10px 14px; border: 1px solid var(--accent); }
  .review-main { padding-bottom: 32px; }
  .review-section { padding: 46px 0; border-bottom: 1px solid var(--border); }
  .section-heading { max-width: 820px; margin-bottom: 24px; }
  .section-heading h2 { margin: 0; font-size: clamp(28px, 4vw, 42px); line-height: 1.08; letter-spacing: -.03em; }
  .section-heading p { margin: 12px 0 0; color: var(--text-dim); }
  .concept-grid, .choice-grid, .final-state-grid { display: grid; gap: 14px; }
  .concept-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .choice-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .final-state-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  article { padding: 20px; border: 1px solid var(--border); background: var(--panel); }
  article h3 { margin: 0; font-size: 18px; }
  article p { margin: 9px 0 0; color: var(--text-dim); }
  .choice-label { margin: 0 0 9px; color: var(--accent); font: 600 11px var(--mono); text-transform: uppercase; }
  .table-wrap { margin-top: 20px; overflow-x: auto; border: 1px solid var(--border); }
  table { width: 100%; min-width: 740px; border-collapse: collapse; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  thead th { color: var(--text-faint); background: var(--bg-elev); font: 600 11px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  tbody th { width: 21%; }
  tbody td { color: var(--text-dim); }
  .implementation-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .implementation-grid article { min-width: 0; padding: 0; overflow: hidden; }
  .implementation-grid h3 { padding: 20px 20px 0; }
  .theme-reference { margin-top: 16px; overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: var(--panel); transition: border-color .18s ease, box-shadow .18s ease; }
  .theme-reference:hover { border-color: color-mix(in srgb, var(--accent) 34%, var(--border)); }
  .theme-reference[open] { border-color: color-mix(in srgb, var(--accent) 42%, var(--border)); box-shadow: 0 12px 30px rgb(15 23 42 / .08); }
  .theme-reference summary { display: flex; align-items: center; gap: 12px; padding: 13px 14px; cursor: pointer; list-style: none; user-select: none; }
  .theme-reference summary::-webkit-details-marker { display: none; }
  .theme-reference summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; border-radius: 10px; }
  .theme-reference-icon { display: grid; place-items: center; width: 34px; height: 34px; flex: 0 0 auto; border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--border)); border-radius: 9px; color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .theme-reference-icon svg, .theme-reference-chevron { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme-reference-copy { display: grid; min-width: 0; gap: 2px; }
  .theme-reference-copy strong { color: var(--text); font-size: 14px; line-height: 1.35; }
  .theme-reference-copy span { color: var(--text-dim); font-size: 12px; line-height: 1.4; }
  .theme-reference-chevron { margin-left: auto; flex: 0 0 auto; color: var(--text-faint); transition: transform .2s ease, color .2s ease; }
  .theme-reference[open] .theme-reference-chevron { transform: rotate(180deg); color: var(--accent); }
  .theme-reference-body { border-top: 1px solid var(--border); background: var(--code-bg); }
  .theme-reference-body p { margin: 0; padding: 14px 16px 0; color: var(--text-dim); font-size: 13px; }
  .theme-reference-body :global(pre) { margin: 0; padding: 16px; overflow-x: auto; background: transparent !important; font-size: 12px; line-height: 1.6; }
  .code-intro { padding: 0 20px; }
  .implementation-grid ol { min-height: 116px; margin: 14px 20px 20px; padding-left: 20px; color: var(--text-dim); }
  .implementation-grid li + li { margin-top: 6px; }
  .implementation-grid :global(pre) { margin: 0; padding: 18px 20px; overflow-x: auto; background: var(--code-bg) !important; font-size: 12px; line-height: 1.6; }
  .detail-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .detail-links a { padding: 17px 18px; border: 1px solid var(--border); background: var(--panel); }
  .detail-links strong { display: block; color: var(--accent); }
  .detail-links span { display: block; margin-top: 6px; color: var(--text-dim); font-size: 14px; line-height: 1.5; }
  @media (max-width: 900px) {
    .concept-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .choice-grid, .implementation-grid { grid-template-columns: 1fr; }
    .implementation-grid ol { min-height: 0; }
  }
  @media (max-width: 620px) {
    .concept-grid, .final-state-grid, .detail-links { grid-template-columns: 1fr; }
  }
</style>
