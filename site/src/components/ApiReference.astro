---
import { apiReference, formatRenderModeGuidance, optionalChartRenderers } from '../lib/api-reference';
import InlineApiDescription from './InlineApiDescription.astro';
interface Props {
  format: 'docx' | 'xlsx' | 'pptx';
}
const { format } = Astro.props;
const classes = apiReference[format];
const isEventHandler = (name: string) => name.startsWith('on');
const groupedClasses = classes.map((apiClass) => ({
  ...apiClass,
  properties: (apiClass.options ?? []).filter((option) => !isEventHandler(option.name)),
  eventHandlers: (apiClass.options ?? []).filter((option) => isEventHandler(option.name)),
}));
const borrowedEngine = {
  docx: { className: 'DocxDocument', factory: 'fromDocument()' },
  pptx: { className: 'PptxPresentation', factory: 'fromPresentation()' },
  xlsx: { className: 'XlsxWorkbook', factory: 'fromWorkbook()' },
}[format];
const viewerName = { docx: 'DocxViewer', xlsx: 'XlsxViewer', pptx: 'PptxViewer' }[format];
const viewerTarget = format === 'xlsx' ? 'container' : 'canvas';
const formatModeNote = formatRenderModeGuidance[format];
const rendererExample = `import { ${viewerName} } from '@silurus/ooxml/${format}';
import { threeD } from '@silurus/ooxml/three-d';
import { regionMap } from '@silurus/ooxml/region-map';

const viewer = new ${viewerName}(${viewerTarget}, {
  mode: 'worker',
  threeD,
  regionMap,
});`;
---
<section class="api" data-reveal>
  <p class="api-badge">API reference</p>
  <h3 class="api-title">Options &amp; methods</h3>
  <p class="api-desc">
    Every public option and method, straight from the source. Types omitted for brevity are exported
    from the package — your editor will autocomplete the rest.
  </p>

  <div class="api-ownership">
    <h4>Choose a rendering mode</h4>
    <p>
      Both modes parse the Office package in a Worker. The difference is where document layout and
      Canvas rendering run. Start with <code>main</code>; choose <code>worker</code> when rendering
      noticeably competes with the rest of your application UI.
    </p>
    <div class="api-mode-table-wrap">
      <table class="api-mode-table">
        <thead>
          <tr><th>Decision</th><th><code>mode: 'main'</code> (default)</th><th><code>mode: 'worker'</code></th></tr>
        </thead>
        <tbody>
          <tr>
            <th>Best for</th>
            <td>Ordinary previews, smaller files, custom renderers and the smallest worker download.</td>
            <td>Larger or more complex documents where rendering can interrupt scrolling, navigation or other UI.</td>
          </tr>
          <tr>
            <th>Rendering</th>
            <td>Layout and Canvas paint run on the main thread.</td>
            <td>Layout and Canvas paint run in a Web Worker; the Viewer presents the returned frame.</td>
          </tr>
          <tr>
            <th>Trade-offs</th>
            <td>No frame-transfer overhead, but heavy rendering can occupy the UI thread.</td>
            <td>Requires Worker + OffscreenCanvas, downloads a larger worker and transfers one bitmap per frame.</td>
          </tr>
          <tr>
            <th>Optional renderers</th>
            <td>Built-in and custom renderer objects.</td>
            <td>Built-in math, 3-D and Region Map renderers; arbitrary custom renderer objects cannot be transferred.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>{formatModeNote}</p>

    <h4>Choose who owns loading</h4>
    <p>
      <strong>Normal case:</strong> construct the Viewer, then call <code>viewer.load(source)</code>.
      The Viewer owns the parsed engine, supports replacement loads, and destroys it during teardown.
    </p>
    <p>
      <strong>Shared-engine case:</strong> load <code>{borrowedEngine.className}</code> once and create
      each view with <code>{borrowedEngine.factory}</code>. This is mutually exclusive with Viewer loading:
      <code>load()</code> is unavailable, and the caller must destroy the borrowed engine after every
      view has been destroyed.
    </p>
    <div class="api-mode-table-wrap">
      <table class="api-mode-table">
        <thead>
          <tr><th>Loading ownership</th><th>Setup</th><th>Cleanup</th></tr>
        </thead>
        <tbody>
          <tr>
            <th>Viewer-owned (normal)</th>
            <td>Pass <code>mode</code> to the Viewer, then call <code>load(source)</code>.</td>
            <td>Destroy the Viewer; it also destroys its engine.</td>
          </tr>
          <tr>
            <th>Shared engine</th>
            <td><code>{borrowedEngine.className}.load(source, {'{'} mode: 'worker' {'}'})</code>, then <code>{borrowedEngine.factory}</code>.</td>
            <td>Destroy every View first, then destroy the shared engine.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      On the shared-engine path, the engine's mode is authoritative: <code>{borrowedEngine.factory}</code>
      deliberately does not accept a mode and cannot switch an already-loaded engine.
    </p>
  </div>

  <div class="api-errors">
    <h4>Error handling</h4>
    <p>
      Typed container, resource-limit and decoded-image failures expose stable fields. Other failures
      remain ordinary JavaScript errors. The callback and Promise delivery rules are part of the public contract.
    </p>
    <a class="api-detail-link" href="/errors">Open the error reference →</a>
  </div>

  <div class="api-selection">
    <h4>Selection context for AI and external tools</h4>
    <p>
      Viewer selection remains read-only UI state. <code>getSelectionContext()</code> turns the
      current focus into a detached, resource-bounded snapshot; every format can notify you through
      <code>onSelectionContextChange</code> when that snapshot may have changed.
    </p>
    <a class="api-detail-link" href="/selection-context">Open the selection &amp; AI guide →</a>
  </div>

  <div id="chart-rendering-addons" class="api-addons">
    <h4>Optional chart renderers</h4>
    <p>
      3-D charts and country Region Maps are optional renderer modules shared by DOCX, XLSX and PPTX.
      Omit them to keep the base graph smaller. Authored 3-D charts retain the canonical 2-D
      fallback; Region Maps require their renderer. The built-in renderers work in both render modes.
    </p>
    <pre><code>{rendererExample}</code></pre>
    <div class="api-addon-table-wrap">
      <table class="api-addon-table">
        <thead><tr><th>Renderer</th><th>Entry / export</th><th>Contract</th><th>Scope</th></tr></thead>
        <tbody>
          {optionalChartRenderers.map((renderer) => (
            <tr>
              <th>{renderer.name}</th>
              <td><code>{renderer.entry}</code><br /><code>{renderer.exportName}</code></td>
              <td><code>{renderer.contract}</code></td>
              <td>{renderer.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <a class="api-detail-link" href="/announcements/v079-chart-rendering-addons">Read the chart rendering release note →</a>
  </div>

  {groupedClasses.map((c) => (
    <div class="api-class">
      <h4 class="api-class-name">{c.name}</h4>
      {c.note && <p class="api-note">{c.note}</p>}
      <pre class="api-ctor"><code>{c.ctor}</code></pre>

      {c.properties.length + c.eventHandlers.length > 0 && (
        <>
          <p class="api-sub">Options</p>
          <div class="api-table-wrap">
            <table class="api-table api-options-table">
              <colgroup>
                <col class="api-option-col" />
                <col class="api-type-col" />
                <col class="api-default-col" />
                <col class="api-description-col" />
              </colgroup>
              <thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
              {c.properties.length > 0 && (
                <tbody class="api-option-group">
                  <tr class="api-group-row">
                    <th scope="rowgroup" colspan="4">Properties</th>
                  </tr>
                  {c.properties.map((o) => (
                    <tr>
                      <td><code>{o.name}</code></td>
                      <td><code class="api-type">{o.type}</code></td>
                      <td>{o.def ? <code>{o.def}</code> : <span class="api-dash">—</span>}</td>
                      <td class="api-description">
                        <InlineApiDescription item={o} />
                        {o.detailsHref && (
                          <> <a class="api-detail-link" href={o.detailsHref}>{o.detailsLabel ?? 'Details'} →</a></>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              )}
              {c.eventHandlers.length > 0 && (
                <tbody class="api-option-group">
                  <tr class="api-group-row">
                    <th scope="rowgroup" colspan="4">Event handlers</th>
                  </tr>
                  {c.eventHandlers.map((o) => (
                    <tr>
                      <td><code>{o.name}</code></td>
                      <td><code class="api-type">{o.type}</code></td>
                      <td>{o.def ? <code>{o.def}</code> : <span class="api-dash">—</span>}</td>
                      <td class="api-description">
                        <InlineApiDescription item={o} />
                        {o.detailsHref && (
                          <> <a class="api-detail-link" href={o.detailsHref}>{o.detailsLabel ?? 'Details'} →</a></>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              )}
            </table>
          </div>
        </>
      )}

      <p class="api-sub">Methods</p>
      <div class="api-table-wrap">
        <table class="api-table api-methods-table">
          <colgroup>
            <col class="api-signature-col" />
            <col class="api-method-description-col" />
          </colgroup>
          <tbody>
            {c.methods.map((m) => (
              <tr>
                <td class="api-sig"><code>{m.sig}</code></td>
                <td class="api-description">
                  <InlineApiDescription item={m} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</section>

<style>
  .api { padding: 40px 0 8px; border-top: 1px solid var(--border); }
  .api-badge {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent); margin: 0;
  }
  .api-title { font-size: 24px; font-weight: 700; margin: 8px 0 8px; }
  .api-desc { color: var(--text-dim); font-size: 16px; max-width: 70ch; margin: 0 0 8px; }

  .api-ownership { margin-top: 30px; padding: 26px 28px 28px; border: 1px solid var(--border); background: var(--bg-elev); }
  .api-ownership h4 { margin: 0; font-size: 19px; }
  .api-ownership p { max-width: 92ch; margin: 10px 0 0; color: var(--text-dim); font-size: 14.5px; }
  .api-ownership code { font-family: var(--mono); font-size: 0.9em; color: var(--text); }
  .api-mode-table-wrap { margin-top: 14px; overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .api-mode-table { width: 100%; min-width: 680px; border-collapse: collapse; font-size: 13.5px; }
  .api-mode-table th, .api-mode-table td { padding: 10px 12px; text-align: left; vertical-align: top; border-top: 1px solid var(--border); }
  .api-mode-table thead th { border-top: 0; background: var(--code-bg); color: var(--text); font-weight: 700; }
  .api-mode-table tbody th { width: 150px; color: var(--text); white-space: nowrap; }
  .api-mode-table td { color: var(--text-dim); }
  .api-mode-table th + th, .api-mode-table th + td, .api-mode-table td + td { border-left: 1px solid var(--border); }

  .api-errors, .api-selection, .api-addons { margin-top: 30px; padding: 26px 28px 28px; border: 1px solid var(--border); background: var(--bg-elev); }
  .api-errors h4, .api-selection h4, .api-addons h4 { margin: 0; font-size: 19px; }
  .api-errors > p, .api-selection > p, .api-addons > p { max-width: 92ch; margin: 10px 0 14px; color: var(--text-dim); font-size: 14.5px; }
  .api-selection code, .api-addons code { font-family: var(--mono); font-size: .9em; color: var(--text); }
  .api-addons > pre { margin: 14px 0; padding: 16px 18px; overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; background: var(--code-bg); }
  .api-addons > pre code { white-space: pre; color: var(--code-keyword); }
  .api-addon-table-wrap { margin: 14px 0; overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .api-addon-table { width: 100%; min-width: 820px; border-collapse: collapse; font-size: 13.5px; }
  .api-addon-table th, .api-addon-table td { padding: 10px 12px; text-align: left; vertical-align: top; border-top: 1px solid var(--border); }
  .api-addon-table thead th { border-top: 0; background: var(--code-bg); color: var(--text); }
  .api-addon-table tbody th { color: var(--text); white-space: nowrap; }
  .api-addon-table td { color: var(--text-dim); }
  .api-addon-table th + th, .api-addon-table th + td, .api-addon-table td + td { border-left: 1px solid var(--border); }
  .api-detail-link { color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .api-class { margin-top: 30px; }
  .api-class-name { font-family: var(--mono); font-size: 18px; font-weight: 700; margin: 0; }
  .api-note { color: var(--text-dim); font-size: 14.5px; margin: 8px 0 12px; max-width: 74ch; }
  .api-ctor {
    margin: 0 0 18px; padding: 12px 16px; overflow-x: auto;
    background: var(--code-bg); border: 1px solid var(--border); border-radius: 10px;
  }
  .api-ctor code { font-family: var(--mono); font-size: 13px; color: var(--code-keyword); }

  .api-sub {
    font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--text-faint); margin: 16px 0 8px;
  }
  .api-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .api-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .api-options-table { table-layout: fixed; min-width: 760px; }
  .api-option-col { width: 18%; }
  .api-type-col { width: 22%; }
  .api-default-col { width: 15%; }
  .api-description-col { width: 45%; }
  .api-methods-table { table-layout: fixed; min-width: 680px; }
  .api-signature-col { width: 40%; }
  .api-method-description-col { width: 60%; }
  .api-table th {
    text-align: left; font-weight: 600; color: var(--text-dim); font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.04em;
    padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--bg-elev);
  }
  .api-group-row th {
    padding-block: 8px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--code-bg);
    color: var(--text);
    font-size: 11px;
    letter-spacing: .08em;
  }
  .api-table td { padding: 10px 14px; border-top: 1px solid var(--border); color: var(--text-dim); vertical-align: top; }
  .api-table tbody tr:first-child td { border-top: none; }
  .api-table code { font-family: var(--mono); font-size: 12.5px; color: var(--text); white-space: nowrap; }
  .api-options-table td:nth-child(-n + 3) code {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .api-table .api-type { color: var(--accent-2); }
  .api-sig code { color: var(--accent); white-space: normal; overflow-wrap: anywhere; }
  .api-dash { color: var(--text-faint); }
</style>
